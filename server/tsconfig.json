{
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "dist",

    "module": "commonjs",
    "target": "es2020",
    "types": ["jest", "node"],

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "strict": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    "esModuleInterop": true,
    "ignoreDeprecations": "6.0"
  },
 "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.integration.test.ts",
    "jest.setup.ts"
  ]
}